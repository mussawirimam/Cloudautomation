### EXPLICIT DEPENDENCY:
Q: How can I make the dependency explicit? 
SCENERIO
### if I want to explicitly specify that random_pet 1 should create then 3 then 2, how can we do that?
### for that we have a keyword: depends_on
cat <<'eod' > main.tf 
### resource
resource "local_file" "myfirstfile1" {
  filename = var.filename
  content = "hello guys welcome to my file"  
  #content  = var.file_content
  #content  = "my new file content ${random_pet.mypetname.id}"
}

resource "random_pet" "mypetname1" {
  length    = 1
  prefix    = "MR"
  separator = "."
}

resource "random_pet" "mypetname3" {
  length    = 2
  prefix    = "MR"
  separator = "."
}

resource "random_pet" "mypetname2" {
  length    = 10
  prefix    = "MR"
  separator = "."
}

### output block
output "my_pet_name" {
  value = random_pet.mypetname.id
}
eod

### DEPNDS_ON EXPLICIT DEPENDENCY DEMO
cat <<'eod' > main.tf 
### resource
resource "local_file" "myfirstfile1" {
  filename = var.filename
  content = "hello guys welcome to my file"  
  #content  = var.file_content
  #content  = "my new file content ${random_pet.mypetname.id}"
}

resource "random_pet" "mypetname1" {
  length    = 1
  prefix    = "MR"
  separator = "."
}

resource "random_pet" "mypetname3" {
  length    = 2
  prefix    = "MR"
  separator = "."
  depends_on = [
    random_pet.mypetname1
  ]  
}

resource "random_pet" "mypetname2" {
  length    = 10
  prefix    = "MR"
  separator = "."
}
/*
### output block
output "my_pet_name" {
  value = random_pet.mypetname.id
}
*/ 
eod

